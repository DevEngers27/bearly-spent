# Copy to .env (never commit it) and fill in what you have. Everything is optional:
# without keys MoneyQuest runs fully offline with a simulated bank and a rule-based buddy.

# Claude-powered Money Buddy (Anthropic)
ANTHROPIC_API_KEY=
# BUDDY_MODEL=claude-opus-5
# BUDDY_EFFORT=low

# Mirror the simulated ledger to Capital One's Nessie sandbox
NESSIE_API_KEY=

# Cartesia voice for Money Buddy (falls back to browser speech). Keys: https://play.cartesia.ai/keys
CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=        # pick one from the voice library; defaults to the voice in Cartesia's docs example
# CARTESIA_MODEL=sonic-3.6
# CARTESIA_VERSION=2026-08-14

# Demo tuning
# ADVENTURE_SECONDS=15
# PORT=8787
