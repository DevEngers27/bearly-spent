# Copy to .env (never commit it) and fill in what you have. Everything is optional:
# without keys the local API uses a simulated bank and a rule-based Buddy.
# Network-offline mode is read-only on a previously cached paired kid device.

# Claude-powered Money Buddy (Anthropic)
ANTHROPIC_API_KEY=
# BUDDY_MODEL=claude-opus-5-5
# BUDDY_GUARD_MODEL=claude-haiku-5-5
# BUDDY_EFFORT=low

# Mirror the simulated ledger to Capital One's Nessie sandbox
NESSIE_API_KEY=
# NESSIE_BASE_URL=https://api.nessieisreal.com
# The sandbox keeps whole-dollar records with no payee on transfers; MoneyQuest mirrors an internal
# move as a transfer on the source account plus a deposit on the destination, exact amount in the description.
# NESSIE_ALLOW_HTTP=1       # local development only; HTTPS is required otherwise


# Accounts/storage (requires Node >=22.9; launch scripts enable node:sqlite)
MQ_DEMO=1
# Remove this line or set MQ_DEMO=0 to hide demo login and simulated funding controls.
# Demo parent: demo@moneyquest.test / demo-pass-1234; no default parent PIN.
# MQ_DATA_DIR=./data
# NODE_OPTIONS=--experimental-sqlite  # direct node commands on Node 22.9-22.12
# NODE_ENV=production      # also makes session cookies Secure; serve over HTTPS

# Demo tuning
# ADVENTURE_SECONDS=60
# PORT=8787
