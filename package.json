{
  "name": "moneyquest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MoneyQuest — save money, grow your Blob, explore the world.",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"node --env-file-if-exists=.env --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "reset": "rm -f data/db.json && echo 'Demo data reset.'",
    "test": "node --test server/*.test.js",
    "phone": "npm run build && concurrently -k -n app,phone -c magenta,green \"node --env-file-if-exists=.env server/index.js\" \"npx -y cloudflared tunnel --protocol http2 --url http://localhost:8787\""
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
